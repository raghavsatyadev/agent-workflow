{
  "permissions": { "deny": ["Artifact", "Workflow", "ScheduleWakeup"] },
  "model": "opus",
  "advisorModel": "opus",
  "outputStyle": "Concise",
  "enableWorkflows": true,
  "modelSettings": {
    "claude-opus-5": { "effortLevel": "high" },
    "claude-opus-5-5": { "effortLevel": "medium", "autoCompactWindow": 200000 }
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "PLAN_KEEPER_AGY_MODEL": "gemini-3.8-flash-high",
    "PLAN_KEEPER_OLLAMA_MODEL": "nimble:latest"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "token-saver@token-saver": true,
    "plan-keeper@raghav-plugins": true,
    "android-cli@android-cli-plugin": true
  },
  "extraKnownMarketplaces": {
    "token-saver": { "source": { "source": "directory", "path": "{{REPO}}/skills/local-model" } },
    "raghav-plugins": { "source": { "source": "directory", "path": "{{REPO}}/plugins/plan-keeper" } },
    "android-cli-plugin": { "source": { "source": "github", "repo": "android/android-cli-plugin" } }
  },
  "attribution": { "commit": "", "pr": "" }
}
